rules_version = '2';
// Quién puede leer y escribir en el Cuaderno de las Fincas.
// admin: todo · encargado: solo su finca · familia y lector (Claude): solo ver.
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && request.auth.token.email != null; }
    function em() { return request.auth.token.email.lower(); }
    function owner() { return signed() && em() in ['luisbalza97@gmail.com', 'agrobalza@gmail.com']; }
    function hasM() { return signed() && exists(/databases/$(database)/documents/miembros/$(em())); }
    function m() { return get(/databases/$(database)/documents/miembros/$(em())).data; }
    function rol() { return owner() ? 'admin' : (hasM() ? m().rol : 'none'); }
    function admin() { return rol() == 'admin'; }
    function enc() { return rol() == 'encargado'; }
    function viewer() { return rol() in ['admin', 'familia', 'lector']; }
    function anyone() { return rol() in ['admin', 'encargado', 'familia', 'lector']; }
    function miFinca() { return m().finca; }
    function newIsMine() { return request.resource.data.finca == miFinca(); }
    function oldIsMine() { return resource.data.finca == miFinca(); }

    match /miembros/{email} {
      allow read: if admin() || (signed() && email == em());
      allow write: if admin();
    }
    match /fincas/{id} { allow read: if anyone(); allow write: if admin(); }
    match /ajustes/{id} { allow read: if anyone(); allow write: if admin(); }
    match /precios/{id} { allow read: if anyone(); allow write: if admin(); }
    match /cierres/{id} { allow read: if viewer(); allow write: if admin(); }
    match /registros/{id} {
      allow read: if viewer() || (enc() && oldIsMine());
      allow create: if admin() || (enc() && newIsMine());
      allow update: if admin() || (enc() && oldIsMine() && newIsMine());
      allow delete: if admin() || (enc() && oldIsMine());
    }
    match /lotes/{id} {
      allow read: if anyone();
      allow create: if admin() || (enc() && newIsMine());
      allow update: if admin() || (enc() && oldIsMine() && newIsMine());
      allow delete: if admin();
    }
    match /labores/{id} {
      allow read: if anyone();
      allow create, update: if admin() || (enc() && newIsMine());
      allow delete: if admin() || (enc() && oldIsMine());
    }
  }
}
